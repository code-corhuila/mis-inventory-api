FROM python:3.12-slim-bookworm
RUN pip install --no-cache-dir PyYAML==6.0.3 jsonschema==4.26.0 openapi-spec-validator==0.9.0
ENV PYTHONDONTWRITEBYTECODE=1
WORKDIR /workspace
COPY docs docs
COPY tests/check_contracts.py tests/check_contracts.py
RUN python tests/check_contracts.py
ENTRYPOINT ["python", "tests/check_contracts.py"]
